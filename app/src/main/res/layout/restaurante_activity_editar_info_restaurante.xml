<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCFD">

    <!-- Card para nombre del restaurante -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_bar_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/green_light_2"
        android:elevation="4dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Restaurante nombre y tipo de cocina -->
            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SHI - NUÁ"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cuisine_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="peruvian-chinese cuisine"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- BottomNavigationView para cambiar entre fragments principales -->

    <LinearLayout
        android:layout_width="368dp"
        android:layout_height="626dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_card">

        <!-- Nombre del producto -->
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="150dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="138dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="203dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp">

                    <TextView
                        android:id="@+id/tv_historial_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:paddingBottom="8dp"
                        android:text="Editar datos de tu restaurante"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/fragment_container"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.498"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/top_bar_card"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:layout_width="183dp"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Información actualizada de tu negocio"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="127dp"
                        android:layout_height="85dp"
                        android:layout_gravity="center"
                        android:background="@drawable/placeholder" />

                    <Button
                        android:id="@+id/btn_upload_image"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="Subir logo"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"></LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"></LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Subir imagen -->

        <!-- Descripción -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:text="Nombre del restaurante:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_restaurant_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shi-Nua: peruvian-chinese cuisine"
            android:textSize="14sp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp" />

        <!-- Precio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="16sp"
            android:paddingTop="15dp"
            android:paddingBottom="5dp"
            android:text="Cantidad de sucursales:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_restaurant_sucursales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 sucursal"
            android:textSize="15sp"
            android:background="@drawable/border_editar_info"
            android:inputType="numberDecimal"
            android:padding="10dp" />

        <!-- Stock -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="5dp"
            android:text="Ubicacion del local:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_restaurant_ubicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Via Principal 155 Centro Empresarial, San Isidro"
            android:textSize="14sp"
            android:background="@drawable/border_editar_info"
            android:inputType="number"
            android:padding="10dp" />

        <!-- Stock -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="5dp"
            android:text="Descripcion:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_restaurant_descripcion"
            android:layout_width="match_parent"
            android:text="SHI-NUÁ ofrece una comida fusión chino peruana."
            android:textSize="14sp"
            android:layout_height="68dp"
            android:background="@drawable/border_editar_info"
            android:inputType="number"
            android:padding="10dp" />


        <!-- Botón para guardar el producto -->
        <Button
            android:id="@+id/btn_save_restaurant_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="#7854A4"
            android:text="Guardar y continuar"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_light_2"
        app:itemBackground="@drawable/superadmin_nav_ripple"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/restaurante_navigation_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>