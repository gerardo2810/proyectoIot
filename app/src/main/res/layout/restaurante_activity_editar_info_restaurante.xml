<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCFD">

    <!-- Card para nombre del restaurante -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_bar_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/green_light_2"
        android:elevation="4dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Restaurante nombre y tipo de cocina -->
            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SHI - NUÁ"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cuisine_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="peruvian-chinese cuisine"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ScrollView para contenido desplazable -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Botón de retroceso -->
            <ImageButton
                android:id="@+id/back_button2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

            <!-- Información del restaurante y logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="141dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="20dp">

                    <TextView
                        android:id="@+id/tv_historial_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingBottom="8dp"
                        android:text="Editar datos de tu restaurante"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Información actualizada de tu negocio"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="108dp"
                        android:layout_height="87dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:background="@drawable/circle_shape" />

                    <Button
                        android:id="@+id/btn_upload_image"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="Subir logo"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/editar_datos"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#9CFFCDD2"
                android:text="EDITAR DATOS"
                android:textColor="@color/md_theme_errorContainer_mediumContrast"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Información del formulario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:paddingTop="10dp"
                android:text="Nombre del restaurante:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_restaurant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:padding="10dp"
                android:text="Shi-Nua: peruvian-chinese cuisine"
                android:textSize="14sp" />

            <!-- Cantidad de sucursales -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="16sp"
                android:paddingTop="15dp"
                android:paddingBottom="5dp"
                android:text="Eslogan:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_restaurant_eslogan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:inputType="text"
                android:padding="10dp"
                android:text="1 sucursal"
                android:textSize="15sp" />

            <!-- Ubicación del local -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingBottom="5dp"
                android:text="Ubicación del local:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_restaurant_ubicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:inputType="text"
                android:padding="10dp"
                android:text="Via Principal 155 Centro Empresarial, San Isidro"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingBottom="5dp"
                android:text="Tipo de comida"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTipoComida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:entries="@array/tipo_de_comidas"/>

            <!-- Descripción del restaurante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:paddingBottom="5dp"
                android:text="Descripción:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_restaurant_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:maxLines="4"
                android:gravity="top|start"
                android:imeOptions="flagNoEnterAction"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                android:maxLength="100"
                android:padding="10dp"
                android:text="SHI-NUÁ ofrece una comida fusión chino peruana."
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="16sp"
                android:paddingTop="15dp"
                android:paddingBottom="5dp"
                android:text="Precio Delivery:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_restaurant_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border_editar_info"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:text="1 sucursal"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="15dp"
                android:text="Portada del restaurante:"
                android:textColor="@color/md_theme_primaryFixed_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="5dp"
                android:background="#E0E0E0"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/buttonUploadImage"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="Seleccionar foto"
                android:textSize="13sp" />

            <!-- Botón para guardar -->
            <Button
                android:id="@+id/btn_save_restaurant_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:backgroundTint="#7854A4"
                android:text="Guardar y continuar"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
