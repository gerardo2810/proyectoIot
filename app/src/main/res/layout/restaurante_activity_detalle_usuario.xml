<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#FFFFFF">

<androidx.cardview.widget.CardView
    android:id="@+id/top_bar_card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:backgroundTint="@color/green_light_2"
    android:elevation="4dp"
    app:cardCornerRadius="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Restaurante nombre y tipo de cocina -->
        <TextView
            android:id="@+id/restaurant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="INFORMACIÓN DEL USUARIO"
            android:gravity="center_horizontal"
            android:textColor="@color/purple"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

<ScrollView
    android:id="@+id/scrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/top_bar_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/baseline_arrow_back_ios_24" />

        <ImageView
            android:id="@+id/iv_imagen_usuario"
            android:layout_width="219dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:background="@drawable/user"
            android:scaleType="centerCrop" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="Nombre:"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_editar_info"
            android:backgroundTint="#FCE4EC"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="Fecha de nacimiento:"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_Edad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/border_editar_info"
            android:backgroundTint="#FCE4EC"
            android:padding="10dp" />


        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="DNI:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_dni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/border_editar_info"
            android:backgroundTint="#FCE4EC"
            android:padding="10dp" />

        <!-- Precio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="Correo:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_editar_info"
            android:inputType="numberDecimal"
            android:backgroundTint="#FCE4EC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="10dp" />

        <!-- Stock -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="Teléfono:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_editar_info"
            android:inputType="number"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FCE4EC"
            android:padding="10dp" />

        <!-- Tiempo de preparación -->
        <!-- Tiempo de preparación -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="2dp"
            android:text="Cantidad de pedidos:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_total_pedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_editar_info"
            android:inputType="number"
            android:backgroundTint="#F0F4C3"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="2dp"
            android:text="Total gastado:"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/et_total_gastado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_editar_info"
            android:inputType="number"
            android:backgroundTint="#F0F4C3"
            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>

</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>