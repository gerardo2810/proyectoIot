<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".cliente.PerfilRestauranteActivity">
    <!-- FrameLayout para los corazones flotantes -->
    <FrameLayout
        android:id="@+id/floating_hearts_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_alignParentTop="true">
        <!-- Corazones flotantes se agregarán dinámicamente en este contenedor -->
    </FrameLayout>

    <!-- Imagen de portada con flecha para retroceder -->
    <ImageView
        android:id="@+id/cover_image"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        android:background="#E0E0E0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenedor circular para la flecha -->
    <FrameLayout
        android:id="@+id/back_arrow_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/circle_shape"
        app:layout_constraintTop_toTopOf="@id/cover_image"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Flecha centrada dentro del círculo -->
        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:layout_gravity="center"
            android:paddingStart="5dp"/>
    </FrameLayout>

    <!-- Perfil y carrito, y demás componentes anteriores siguen intactos -->
    <LinearLayout
        android:id="@+id/profile_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/cover_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Imagen de perfil -->
        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_shape" />

        <!-- Nombre del restaurante y icono de corazón -->
        <LinearLayout
            android:id="@+id/root_layout"

            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:layout_marginTop="19dp">

            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La Lucha"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/favorite_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/baseline_favorite_24" />
        </LinearLayout>

        <!-- Carrito con contador alineado a la derecha -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/shopping_cart"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:src="@drawable/baseline_shopping_cart_24"
                android:contentDescription="Shopping Cart" />

            <TextView
                android:id="@+id/cart_count"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/circle_shape"
                android:text="4"
                android:textColor="#fff"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="3dp"
                android:textSize="16sp"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Mantener el CardView de la info -->
    <androidx.cardview.widget.CardView
        android:id="@+id/info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/profile_info_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Contenido del CardView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Contenido del CardView -->
            <!-- Precio Delivery, Dirección, Tipo de Comida -->
            <!-- Primera fila: Iconos y etiquetas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Precio Delivery con icono -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery"
                        android:textSize="14sp"
                        android:textColor="#000"
                        android:drawableStart="@drawable/baseline_delivery_dining_24"
                        android:drawablePadding="4dp"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/delivery_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S/. 0.00"
                    android:textSize="14sp"
                    android:textColor="#888"
                    android:gravity="end"
                    android:layout_gravity="end"
                    android:paddingEnd="59dp" />
                </LinearLayout>

                <!-- Dirección con icono -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dirección"
                        android:textSize="14sp"
                        android:textColor="#000"
                        android:drawableStart="@drawable/baseline_location_on_24"
                        android:drawablePadding="4dp"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/restaurant_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dirección"
                        android:textSize="14sp"
                        android:textColor="#888"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Tipo de comida con formato -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de Comida"
                        android:textSize="14sp"
                        android:textColor="#000"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/restaurant_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de comida"
                        android:textSize="14sp"
                        android:textColor="#888"
                        android:gravity="start"
                        android:layout_gravity="start"
                        android:paddingStart="49dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Barra de búsqueda -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/info_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="¿Qué es lo que quieres comer?"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="@drawable/search_background"/>
    </LinearLayout>

    <!-- Aquí el RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_perfil_restaurante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_producto_perfil_restaurante" />

    <!-- Menú inferior sigue igual -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_light_2"
        app:itemBackground="@drawable/superadmin_nav_ripple"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/cliente_navigation_bar" />



</androidx.constraintlayout.widget.ConstraintLayout>
