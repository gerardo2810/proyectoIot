<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="16dp">


        <LinearLayout
            android:id="@+id/header_layout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="7dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/border_layout"
            android:backgroundTint="@color/md_theme_tertiaryFixedDim"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingVertical="13dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">



            <!-- Título del header -->
            <TextView
                android:id="@+id/header_title"
                android:layout_width="306dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Perfil"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="368dp"
        android:layout_height="569dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Título y descripción -->
            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Mi perfil"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/titleTextView"
                android:layout_marginStart="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:text="Información actualizada"
                android:textColor="#BC000000"
                android:textSize="14sp" />


            <!-- Imagen de perfil y botón Subir Foto -->

            <Button
                android:id="@+id/buttonLogOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="26dp"
                android:layout_marginTop="65dp"
                android:backgroundTint="#BD101E"
                android:text="Cerrar Sesion"
                android:textColor="@android:color/white" />

            <LinearLayout
                android:layout_width="224dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="16dp"
                android:layout_toEndOf="@id/subTitleTextView"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Imagen de perfil circular -->
                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:background="@drawable/circle_shape"
                    android:contentDescription="Imagen de perfil"
                    android:src="@drawable/placeholder" />

                <!-- Botón para subir foto -->
                <Button
                    android:id="@+id/buttonUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#10BD2D"
                    android:drawableStart="@drawable/baseline_file_upload_24"
                    android:text="Subir Foto"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Nombre y Apellidos -->
        <EditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nombres"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editTextLastName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Apellidos"
            android:inputType="textPersonName" />


        <!-- Tipo de Documento de Identidad -->
        <Spinner
            android:id="@+id/spinnerIdType"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <!-- Número de Documento -->
        <EditText
            android:id="@+id/editTextIdNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Número de documento de identidad"
            android:inputType="number" />

        <!-- Fecha de nacimiento -->
        <EditText
            android:id="@+id/editTextBirthDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:drawableEnd="@drawable/baseline_calendar_month_24"
            android:focusable="false"
            android:hint="Fecha de nacimiento" />

        <!-- Correo Electrónico -->
        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Correo electronico"
            android:inputType="textEmailAddress" />

        <!-- Teléfono -->

        <!-- Domicilio -->

        <EditText
            android:id="@+id/editTextPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Teléfono"
            android:inputType="phone" />

        <EditText
            android:id="@+id/editTextAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Domicilio"
            android:inputType="textPostalAddress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Botón Regresar -->
            <Button
                android:id="@+id/buttonBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#060F1F"
                android:onClick="abrirPagLogueo"
                android:text="Regresar"
                android:textColor="@color/white" />

            <!-- Espacio entre botones -->
            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_tertiaryFixedDim"
        app:itemBackground="@drawable/superadmin_nav_ripple"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/repartidor_navigation_bar" />


</androidx.constraintlayout.widget.ConstraintLayout>