<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">




    <!-- BottomNavigationView para cambiar entre fragments principales -->

    <LinearLayout
        android:layout_width="353dp"
        android:layout_height="635dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nombre del producto -->
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="124dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="321dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="203dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="20dp">

                    <TextView
                        android:id="@+id/tv_historial_titulo"
                        android:layout_width="101dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:paddingBottom="8dp"
                        android:text="MI PERFIL"
                        android:textAlignment="center"
                        android:textAllCaps="true"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/fragment_container"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.498"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/top_bar_card"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:layout_width="154dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingBottom="8dp"
                        android:text="Edita tus datos personales"
                        android:textAlignment="center"
                        android:textStyle="bold|italic" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="90dp"
                        android:layout_height="75dp"
                        android:layout_gravity="center"
                        android:background="@drawable/user" />

                    <Button
                        android:id="@+id/btn_upload_image"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="2dp"
                        android:text="Editar foto"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"></LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"></LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Subir imagen -->

        <!-- Descripción -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:text="Nombre y Apellidos:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="Pedro Perez"
            android:textSize="13sp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="N° de documento de identidad (DNI):"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_dni"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="60784512"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="Fecha de nacimiento:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_fecha"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="12-10-2000"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="Correo:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_correo"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="pperez@gmail.com"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="Teléfono:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_telefono"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="987654321"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:text="Domicilio:"
            android:textColor="@color/md_theme_primaryFixed_highContrast"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_domicilio"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@drawable/border_editar_info"
            android:padding="10dp"
            android:text="Av. Universitaria 1801, San Miguel, Lima"
            android:textSize="13sp" />


        <!-- Botón para guardar el producto -->
        <Button
            android:id="@+id/btn_save_personal_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:backgroundTint="#7854A4"
            android:text="Guardar y continuar"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_tertiaryFixedDim"
        app:itemBackground="@drawable/superadmin_nav_ripple"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/repartidor_navigation_bar" />


</androidx.constraintlayout.widget.ConstraintLayout>