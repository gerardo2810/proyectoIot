<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"

    tools:context=".cliente.seguimiento_pedido_2_cliente">

    <!-- Header con ícono de flecha y título -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:minHeight="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Flecha de retroceso más pequeña -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:contentDescription="Volver"
            android:padding="8dp" />

        <!-- Texto centrado usando un margin en el TextView -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Detalles de orden"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Línea horizontal de color plomo justo debajo del header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D3D3D3"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        android:layout_marginTop="-10dp" />

    <!-- Título de la orden -->
    <TextView
        android:id="@+id/order_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="La Lucha - Plaza San Miguel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-2dp"
        android:layout_marginStart="16dp" />

    <!-- Estado de la orden y fecha -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/order_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="1dp"
        android:layout_marginStart="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orden entregada"
            android:textColor="#00B050"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • 27/08/2024"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Botón Ver más -->
    <TextView
        android:id="@+id/see_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar Órden"
        android:textColor="#FF0640"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/order_title"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="1dp" />

    <!-- Imagen del mapa -->
    <ImageView
        android:id="@+id/iv_mapa"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/order_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/placeholder"
        android:scaleType="centerCrop" />

    <!-- Sección de seguimiento debajo del mapa -->
    <LinearLayout
        android:id="@+id/seguimiento_pedido_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_mapa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Texto de seguimiento -->
        <TextView
            android:id="@+id/tv_seguimiento_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sigue tu pedido aquí"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="24dp" /> <!-- Añadido margen izquierdo -->

        <!-- Imagen circular y texto de estado -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"> <!-- Añadido margen izquierdo -->

            <!-- Imagen dentro de un círculo -->
            <ImageView
                android:id="@+id/iv_estado_pedido"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/reportes"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_shape"
                android:layout_gravity="start" />

            <!-- Texto del estado -->
            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Recibido!"
                android:textSize="14sp"
                android:textColor="#000000"
                android:gravity="start"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Línea gris divisoria -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D3D3D3"
        android:layout_marginTop="-5dp"
        app:layout_constraintTop_toBottomOf="@id/seguimiento_pedido_layout" />

    <!-- Sección de botones "Detalle de Orden" y "Verificación de Envío" -->
    <LinearLayout
        android:id="@+id/detalles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_background_grey"
        app:layout_constraintTop_toBottomOf="@id/seguimiento_pedido_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="4dp">

        <!-- Botón "Detalle de Orden" con fondo blanco -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tv_detalle_orden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de Orden"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Botón "Verificación de Envío" dentro de un layout para mantener la alineación -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/rounded_background_white"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/tv_verificacion_envio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificación de envío"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/qr_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#D3D3D3"
        app:layout_constraintTop_toBottomOf="@id/detalles"

        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Texto que aparece encima del código QR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muestra tu QR a tu repartidor para que te pueda entregar tu orden y asegurarnos que la entrega fue exitosa"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"
                android:textAlignment="center" />

            <!-- Imagen del código QR -->
            <ImageView
                android:id="@+id/qr_image"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/placeholder"
                android:scaleType="fitCenter"
                android:contentDescription="QR Code" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>