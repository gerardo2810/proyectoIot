<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Define el color y grosor del borde -->
    <stroke
        android:width="0dp"
        android:color="@color/md_theme_primary_highContrast" /> <!-- Color del borde (negro) -->

    <!-- Define el color de fondo, si lo deseas -->
    <solid android:color="#EDE6F8" />

    <!-- Define el radio de las esquinas del borde -->
    <corners android:radius="5dp" /> <!-- Esquinas redondeadas -->

    <!-- Define el padding interno, si lo necesitas -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>