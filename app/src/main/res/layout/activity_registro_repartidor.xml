<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity"
    android:background="#E0E0E0">

    <!-- Card para los datos -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="689dp"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Título y descripción -->
                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:text="¡Únete al equipo¡"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/titleTextView"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginBottom="16dp"
                    android:text="Registra tus datos personales"
                    android:textColor="#BC000000"
                    android:textSize="14sp" />

                <!-- Imagen de perfil y botón Subir Foto -->

                <LinearLayout
                    android:layout_width="224dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="30dp"
                    android:layout_toEndOf="@id/subTitleTextView"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                <!-- Imagen de perfil circular -->
                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/circle_shape"
                        android:contentDescription="Imagen de perfil"
                        android:src="@drawable/placeholder" />

                    <!-- Botón para subir foto -->
                    <Button
                        android:id="@+id/buttonUpload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#10BD2D"
                        android:drawableStart="@drawable/baseline_file_upload_24"
                        android:text="Subir Foto"
                        android:textColor="@android:color/white" />
                </LinearLayout>

            </RelativeLayout>

            <!-- Nombre y Apellidos -->
            <EditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nombres"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/editTextLastName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Apellidos"
                android:inputType="textPersonName" />


            <!-- Tipo de Documento de Identidad -->
            <Spinner
                android:id="@+id/spinnerIdType"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <!-- Número de Documento -->
            <EditText
                android:id="@+id/editTextIdNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Número de documento de identidad"
                android:inputType="number" />

            <!-- Fecha de nacimiento -->
            <EditText
                android:id="@+id/editTextBirthDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:drawableEnd="@drawable/baseline_calendar_month_24"
                android:hint="Fecha de nacimiento"
                android:focusable="false"
                android:clickable="true" />

            <!-- Correo Electrónico -->
            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Correo electronico"
                android:inputType="textEmailAddress" />

            <!-- Teléfono -->

            <!-- Domicilio -->

            <EditText
                android:id="@+id/editTextPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Teléfono"
                android:inputType="phone" />

            <EditText
                android:id="@+id/editTextAddress"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Domicilio"
                android:inputType="textPostalAddress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Botón Regresar -->
                <Button
                    android:id="@+id/buttonBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#060F1F"
                    android:onClick="abrirPagLogueo"
                    android:text="Regresar"
                    android:textColor="@color/white" />

                <!-- Espacio entre botones -->
                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <!-- Botón Crear Cuenta -->
                <Button
                    android:id="@+id/buttonCreateAccount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/purple_700"
                    android:onClick="abrirPagLogueoExitoso"
                    android:text="Registrar"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>