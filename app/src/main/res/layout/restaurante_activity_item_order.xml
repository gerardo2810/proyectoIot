<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/newpedido1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/border_pedido"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:backgroundTint="@color/md_theme_surfaceContainer_highContrast"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.341">

        <!-- Icono de pedido -->
        <ImageView
            android:id="@+id/iv_order_icon"
            android:layout_width="52dp"
            android:layout_height="61dp"
            android:paddingRight="10dp"
            android:src="@drawable/histoial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Información de la orden -->
        <LinearLayout
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_order_icon"
            app:layout_constraintTop_toTopOf="parent">

            <!-- ID del pedido -->

            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#BBDEFB"
                android:text="ID 0000012"
                android:textSize="16sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tv_order_cliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ana Maria"
                android:textColor="@color/md_theme_tertiary_highContrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Dirección -->
            <TextView
                android:id="@+id/tv_order_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="El Molle # 156 B"
                android:textColor="#888888"
                android:textSize="16sp" />

            <!-- Precio -->
            <TextView
                android:id="@+id/tv_order_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S/ 106.00"
                android:textColor="@android:color/black"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Estado del pedido -->

        <!-- Flecha para más detalles -->

        <LinearLayout
            android:layout_width="118dp"
            android:layout_height="71dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_order_status"
                android:layout_width="135dp"
                android:layout_height="33dp"
                android:layout_gravity="center"
                android:background="@drawable/border_editar_info"
                android:padding="7dp"
                android:text="EN CAMINO"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_order_details"
                android:layout_width="41dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingTop="10dp"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@android:color/black" />

        </LinearLayout>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
