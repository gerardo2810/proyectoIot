<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main_layout"
    android:layout_height="match_parent">

    <!-- Fondo del mapa (Placeholder por ahora) -->
    <ImageView
        android:id="@+id/map_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/placeholder"
        android:scaleType="centerCrop" />

    <!-- Card superior -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_superior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        android:layout_gravity="top"
        app:cardElevation="6dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre del restaurante y estado de la orden -->
            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Restaurante"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu orden está activa y en progreso"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <!-- Tracking de estados -->
            <LinearLayout
                android:id="@+id/tracking_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <!-- Estado 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/placeholder"
                        android:background="@drawable/circle_shape" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparando"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Línea entre estados -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#CCCCCC"
                    android:layout_gravity="center_vertical" />

                <!-- Estado 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/placeholder"
                        android:background="@drawable/circle_white_shape" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En camino"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Línea entre estados -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#CCCCCC"
                    android:layout_gravity="center_vertical" />

                <!-- Estado 3 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/placeholder"
                        android:background="@drawable/fui_ic_check_circle_black_128dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregado"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card deslizante (BottomSheet) -->
    <com.google.android.material.bottomsheet.BottomSheetBehavior
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        app:behavior_hideable="false"
        app:behavior_peekHeight="200dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <!-- Switch entre Detalle de Orden y Verificación de Envío -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tab_order_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Detalle del Pedido"
                    android:textColor="#000000"
                    android:background="@drawable/pdf_sa" />

                <TextView
                    android:id="@+id/tab_verification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Verificación de Envío"
                    android:textColor="#000000"
                    android:background="@drawable/pasta" />
            </LinearLayout>

            <!-- Contenido para Detalles -->
            <LinearLayout
                android:id="@+id/order_details_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/restaurant_name_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Restaurante"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/restaurant_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dirección: Av. Ejemplo 123"
                    android:textSize="14sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/total_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pago Total: S/. 50.00"
                    android:textSize="14sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/delivery_person"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repartidor: Juan Pérez"
                    android:textSize="14sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <!-- Contenido para Verificación de Envío -->
            <LinearLayout
                android:id="@+id/verification_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Muestra tu QR a tu repartidor para que te pueda entregar tu orden y asegurarnos que la entrega fue exitosa"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:layout_marginBottom="16dp"
                    android:textAlignment="center" />

                <ImageView
                    android:id="@+id/qr_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/placeholder"
                    android:scaleType="fitCenter"
                    android:contentDescription="QR Code" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.bottomsheet.BottomSheetBehavior>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
